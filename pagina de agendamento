<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Agendamento | Aurora</title>
  <style>
    body {
      font-family: 'Segoe UI', sans-serif;
      background-color: #fffafc;
      color: #333;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
    }

    /* ---------- MENU LATERAL ---------- */
    .menu-toggle {
      position: fixed;
      top: 20px;
      right: 20px;
      background: #c5a78d;
      border: none;
      padding: 10px 15px;
      border-radius: 5px;
      color: #fff;
      font-size: 1rem;
      cursor: pointer;
      z-index: 1001;
    }

    .sidebar {
      position: fixed;
      top: 0;
      right: -260px;
      width: 260px;
      height: 100%;
      background-color: #fefefe;
      box-shadow: -2px 0 8px rgba(0,0,0,0.1);
      padding: 20px;
      transition: right 0.3s ease;
      z-index: 1000;
      border-left: 1px solid #eee;
    }

    .sidebar.open {
      right: 0;
    }

    .sidebar h2 {
      font-size: 1.5rem;
      margin-bottom: 20px;
      color: #5e5047;
    }

    .sidebar ul {
      list-style: none;
      padding: 0;
    }

    .sidebar ul li {
      padding: 12px 10px;
      border-radius: 8px;
      margin-bottom: 10px;
      cursor: pointer;
      color: #5e5047;
      transition: background 0.2s;
    }

    .sidebar ul li:hover {
      background-color: #f3f0ee;
    }

    .overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.3);
      display: none;
      z-index: 999;
    }

    .overlay.active {
      display: block;
    }

    @media (max-width: 600px) {
      .sidebar {
        width: 80%;
      }
    }

    /* ---------- CONTEÚDO PRINCIPAL ---------- */
    header {
      width: 100%;
      max-width: 600px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.5rem 2rem;
      box-sizing: border-box;
    }

    .story {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      border: 4px solid #c5a78d;
      overflow: hidden;
      background-color: #ffe3ec;
      background-size: cover;
      background-position: center;
      flex-shrink: 0;
    }

    header h1 {
      font-size: 2rem;
      color: #c5a78d;
      margin: 0;
      flex-grow: 1;
      text-align: center;
    }

    main {
      background: #fff;
      border-radius: 20px;
      box-shadow: 0 6px 15px rgba(0,0,0,0.1);
      padding: 2rem;
      width: 90%;
      max-width: 450px;
      margin: 1rem auto 2rem auto;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    h2 {
      text-align: center;
      color: #c5a78d;
      margin-bottom: 1.5rem;
      font-size: 1.4rem;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      width: 100%;
    }

    label {
      font-weight: 500;
      color: #555;
    }

    input {
      padding: 0.8rem;
      border: 1px solid #c5a78d;
      border-radius: 10px;
      font-size: 1rem;
      outline: none;
      background-color: #fffafc;
      width: 100%;
    }

    input:focus {
      border-color: #e57aa5;
      box-shadow: 0 0 5px rgba(229,122,165,0.4);
    }

    /* Calendário */
    .calendar {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 8px;
      text-align: center;
      margin-top: 1rem;
    }

    .day {
      padding: 10px;
      border-radius: 8px;
      cursor: pointer;
      background-color: #fff;
      transition: 0.2s;
      border: 1px solid #f0dada;
    }

    .day:hover {
      background-color: #f8c7d8;
      color: #fff;
    }

    .unavailable {
      background-color: #ddd;
      color: #777;
      cursor: not-allowed;
    }

    .selected {
      background-color: #e57aa5 !important;
      color: #fff !important;
    }

    /* Horários */
    .horarios {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      justify-content: center;
      margin-top: 1rem;
    }

    .hora {
      padding: 0.6rem 1rem;
      border: 1px solid #c5a78d;
      border-radius: 8px;
      cursor: pointer;
      transition: 0.2s;
      background-color: #fff;
    }

    .hora:hover {
      background-color: #f8c7d8;
      color: white;
    }

    .hora.selecionada {
      background-color: #e57aa5;
      color: white;
    }

    /* Botão principal */
    button[type="submit"] {
      background-color: #ffe3ec;
      color: #333;
      border: 1px solid #c5a78d;
      border-radius: 12px;
      padding: 1rem;
      font-size: 1rem;
      margin-top: 1.5rem;
      width: 100%;
      cursor: pointer;
      transition: 0.3s;
      font-weight: 500;
    }

    button[type="submit"]:hover {
      background-color: #f8c7d8;
      color: white;
    }

    footer {
      text-align: center;
      color: #888;
      font-size: 0.9rem;
      margin: 1rem 0;
    }

    /* Responsividade */
    @media (max-width: 600px) {
      header {
        flex-direction: column;
        text-align: center;
        gap: 1rem;
        padding: 1rem;
      }

      .story {
        width: 100px;
        height: 100px;
      }

      header h1 {
        font-size: 1.8rem;
      }

      main {
        width: 95%;
        padding: 1.5rem;
      }
    }
  </style>
</head>
<body>

  <!-- Botão do menu -->
  <button class="menu-toggle" onclick="toggleMenu()">☰ Menu</button>

  <!-- Sidebar -->
  <div class="sidebar" id="sidebar">
    <h2>Menu</h2>
    <ul>
      <li onclick="alert('Conta')">Conta</li>
      <li onclick="alert('Mudar de Conta')">Mudar de Conta</li>
      <li onclick="alert('Acessibilidade')">Acessibilidade</li>
      <li onclick="alert('Idioma')">Idioma</li>
      <li onclick="alert('Configurações')">Configurações</li>
      <li onclick="alert('Ajuda')">Ajuda</li>
    </ul>
  </div>

  <div class="overlay" id="overlay" onclick="toggleMenu()"></div>

  <!-- Conteúdo principal -->
  <header>
    <div class="story" style="background-image: url('https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQuMV1_8b1pjiHe6lTfRLqUZfOtDOOCGQ4rSA&s');"></div>
    <h1>Unhas em Gel</h1>
  </header>

  <main>
    <h2>Agende seu horário</h2>
    <form id="form-agendamento">
      <label for="nome">Nome completo:</label>
      <input type="text" id="nome" name="nome" placeholder="Seu nome" required>

      <label for="telefone">Telefone:</label>
      <input type="tel" id="telefone" name="telefone" placeholder="(00) 00000-0000" required>

      <label>Escolha o dia:</label>
      <div class="calendar" id="calendar"></div>

      <label>Escolha o horário:</label>
      <div class="horarios" id="horarios"></div>

      <button type="submit">Confirmar Agendamento</button>
    </form>
  </main>

  <footer>
    © 2025 Aurora — Todos os direitos reservados
  </footer>

  <script>
    // ===== MENU =====
    function toggleMenu() {
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('overlay');
      sidebar.classList.toggle('open');
      overlay.classList.toggle('active');
    }

    // ===== CALENDÁRIO =====
    const calendar = document.getElementById("calendar");
    const diasNoMes = 30;
    const diasIndisponiveis = [2, 5, 10, 15, 16, 20, 21, 30, 11, 3];
    let diaSelecionado = null;

    for (let i = 1; i <= diasNoMes; i++) {
      const day = document.createElement("div");
      day.textContent = i;
      day.classList.add("day");

      if (diasIndisponiveis.includes(i)) {
        day.classList.add("unavailable");
      } else {
        day.addEventListener("click", () => {
          document.querySelectorAll(".day").forEach(d => d.classList.remove("selected"));
          day.classList.add("selected");
          diaSelecionado = i;
        });
      }

      calendar.appendChild(day);
    }

    // ===== HORÁRIOS =====
    const horarios = ["09h", "10h", "11h", "13h", "14h", "15h", "16h", "17h"];
    const horariosDiv = document.getElementById("horarios");
    let horaSelecionada = null;

    horarios.forEach(h => {
      const btn = document.createElement("div");
      btn.textContent = h;
      btn.classList.add("hora");

      btn.addEventListener("click", () => {
        document.querySelectorAll(".hora").forEach(h => h.classList.remove("selecionada"));
        btn.classList.add("selecionada");
        horaSelecionada = h;
      });

      horariosDiv.appendChild(btn);
    });

    // ===== CONFIRMAÇÃO =====
    document.getElementById("form-agendamento").addEventListener("submit", (event) => {
      event.preventDefault();

      const nome = document.getElementById("nome").value;
      const telefone = document.getElementById("telefone").value;

      if (!diaSelecionado) {
        alert("Por favor, selecione um dia disponível 💅");
        return;
      }

      if (!horaSelecionada) {
        alert("Por favor, escolha um horário disponível ⏰");
        return;
      }

      alert(`✨ Agendamento confirmado! ✨\n\n👤 Nome: ${nome}\n📞 Telefone: ${telefone}\n📅 Dia: ${diaSelecionado}\n🕒 Horário: ${horaSelecionada}`);
    });
  </script>

</body>
</html>
